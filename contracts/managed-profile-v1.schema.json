{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted managed transport policy, never ZIP authority",
  "type": "object",
  "required": [
    "profile_version",
    "enabled",
    "package_ids",
    "operations",
    "method",
    "base_url",
    "path",
    "account_key",
    "account_fields",
    "config_headers",
    "authentication"
  ],
  "additionalProperties": false,
  "properties": {
    "profile_version": {
      "const": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "package_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 150
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "method": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    },
    "base_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "path": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 1024
    },
    "account_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$",
      "maxLength": 100
    },
    "account_fields": {
      "type": "object",
      "maxProperties": 8,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$",
        "maxLength": 100
      }
    },
    "numeric_account_fields": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$",
        "maxLength": 100
      }
    },
    "config_headers": {
      "type": "object",
      "maxProperties": 12,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$",
        "maxLength": 100
      }
    },
    "authentication": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme",
            "username_field",
            "password_field"
          ],
          "properties": {
            "scheme": {
              "const": "basic"
            },
            "username_field": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$",
              "maxLength": 100
            },
            "password_field": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$",
              "maxLength": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme",
            "token_field"
          ],
          "properties": {
            "scheme": {
              "const": "bearer"
            },
            "token_field": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$",
              "maxLength": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme",
            "header",
            "secret_field"
          ],
          "properties": {
            "scheme": {
              "const": "header_secret"
            },
            "header": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9-]{0,79}$"
            },
            "secret_field": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$",
              "maxLength": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme",
            "token_url",
            "client_id_field",
            "client_secret_field",
            "client_authentication",
            "scopes"
          ],
          "properties": {
            "scheme": {
              "const": "oauth2_client_credentials"
            },
            "token_url": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            "client_id_field": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$",
              "maxLength": 100
            },
            "client_secret_field": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$",
              "maxLength": 100
            },
            "client_authentication": {
              "enum": [
                "basic",
                "body"
              ]
            },
            "scopes": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9:._-]{1,100}$"
              }
            }
          }
        }
      ]
    },
    "allow_local_synthetic": {
      "type": "boolean"
    },
    "body_schema": {
      "type": "object",
      "description": "Bounded resource-schema subset; closed objects, declared fields and bounded arrays."
    },
    "body_rules": {
      "type": "object",
      "description": "Existing host-only Laravel rules; portable profiles use body_schema."
    },
    "body_account_bindings": {
      "type": "object",
      "maxProperties": 8,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$",
        "maxLength": 100
      }
    },
    "success_path": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$",
      "maxLength": 100
    },
    "success_value": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "reference_path": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$",
      "maxLength": 100
    },
    "success_policy": {
      "enum": [
        "read_only_json",
        "existing_reference_on_2xx"
      ]
    },
    "timezone_headers": {
      "type": "boolean"
    },
    "body_invocation_projection": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$",
        "maxLength": 100
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$",
            "maxLength": 100
          },
          "field_map": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 32,
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "maxLength": 100
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,5}$",
              "maxLength": 100
            }
          }
        }
      }
    }
  }
}
