{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requested host profile registrations (never profile definitions)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "transport_profiles",
    "verification_profile",
    "inbound_profiles"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "transport_profiles": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[a-z][a-z0-9._-]{0,79}$"
      }
    },
    "verification_profile": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9._-]{0,79}$"
    },
    "inbound_profiles": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[a-z][a-z0-9._-]{0,79}$"
      }
    }
  }
}
