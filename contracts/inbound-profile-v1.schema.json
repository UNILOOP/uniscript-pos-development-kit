{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UniScript operator-owned inbound callback profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "authentication", "label", "reference_field", "event_id_field", "account_fields", "package_ids"],
  "properties": {
    "version": {"const": 1},
    "authentication": {"const": "basic"},
    "label": {"type": "string", "maxLength": 100},
    "reference_field": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]{0,99}$"},
    "event_id_field": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]{0,99}$"},
    "account_fields": {
      "type": "object",
      "maxProperties": 5,
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.]{0,99}$"},
      "additionalProperties": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]{0,99}$"}
    },
    "package_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"}}
  }
}
