{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "editable",
    "schema",
    "values",
    "credentials_host_owned",
    "credential_renewal"
  ],
  "properties": {
    "editable": {
      "type": "boolean"
    },
    "schema": {
      "type": "object"
    },
    "values": {
      "type": [
        "object",
        "array"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "maxItems": 0,
      "description": "Host PHP empty values currently serialize as an empty array; populated values are an object."
    },
    "credentials_host_owned": {
      "const": true
    },
    "credential_renewal": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional host-managed API credential renewal status. Never contains credentials. Null when the host does not provide renewal for this integration.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "renew_after_days": {
          "type": "integer"
        },
        "last_rotated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_rotation_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
